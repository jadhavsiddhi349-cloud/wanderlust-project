<% layout("layouts/boilerplate") %>

    <div class="row">
        <div class="col-8 offset-2">
    <h3>listing details :</h3>
    <div class="card">
        <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="listing-image">
  <div class="card-body">
    <p class="card-text">
        <b><%=listing.title%></b>
        <br> 
        <b><%=listing.description%></b><br>
        <b><%=listing.image.url%></b><br>
        <b>&#8377; <%= listing.price.toLocaleString("en-IN") %></b><br>
        <b><%=listing.location%></b><br>
        <b><%=listing.country%></b><br>
    </p>
  </div>
    </div>
    
    <a href="/testlisting/<%=listing._id%>/edit">edit this info</a>
    <br> <br>
    <form action="/testlisting/<%=listing._id%>?_method=DELETE" method="POST">
        <button>Delete This Listing</button>
    </form>
</div>
