<% layout("layouts/boilerplate") %>

    <div class="row">
        <div class="col-8 offset-2">
    <h3>listing details :</h3>
    <div class="card">
        <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="listing-image">
  <div class="card-body">
    <p class="card-text">
        <b><%=listing.title%></b>
        <br>
        <%=listing.description%><br>
        &#8377; <%= listing.price.toLocaleString("en-IN") %><br>
        <%=listing.location%><br>
        <%=listing.country%><br>
    </p>
  </div>
    </div>
    <div class="btns">
        <a href="/testlisting/<%=listing._id%>/edit" class="btn btn-dark col-1 offset-5 edit-btn">Edit</a>
        <form action="/testlisting/<%=listing._id%>?_method=DELETE" method="POST">
        <button class="btn btn-dark offset-4 ">Delete</button>
    </form>

    </div>
   
    
</div>
